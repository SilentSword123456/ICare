<Window x:Class="ICare.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="ICare" Height="450" Width="680"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/Assets/eye.ico">
    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="12,24,12,24">
                <StackPanel>
                    <Button x:Name="NavOverview"
                            Click="NavOverview_Click"
                            Margin="0,0,0,4"
                            Style="{StaticResource NavButtonActive}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" 
                                                     Width="20" Height="20" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,8,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings"
                            Click="NavSettings_Click"
                            Margin="0,0,0,4"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Settings" 
                                                     Width="20" Height="20" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,8,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            
            <Button Grid.Column="0"
                    x:Name="ThemeIconPath"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Click="SwitchTheme"
                    Background="Transparent"
                    BorderThickness="0"
                    materialDesign:RippleAssist.IsDisabled="True"
                    Margin="0,0,0,8">
                <Path Data="{DynamicResource SwitchThemeIcon}"
                      Fill="{DynamicResource ThemeIconBrush}"
                      Width="24" Height="24"
                      Stretch="Uniform" />
                
            </Button>

            <ContentControl x:Name="ContentArea" Grid.Column="1" />
        </Grid>
    </materialDesign:DialogHost>
</Window>