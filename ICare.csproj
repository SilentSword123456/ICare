<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>

        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <ApplicationIcon>Assets\eye.ico</ApplicationIcon>

        <AssemblyTitle>ICare</AssemblyTitle>
        <Product>ICare</Product>
        <Company>SilentLab</Company>

        <StartupObject>ICare.App</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MaterialDesignThemes" Version="5.3.2"/>
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3"/>
        <PackageReference Include="NAudio" Version="3.0.1" />
        <PackageReference Include="NUnit" Version="4.3.2" />
        <PackageReference Include="Sentry" Version="6.9.0" />
        <PackageReference Include="Velopack" Version="1.2.0" />
        <Resource Include="Assets\background.png" />
        <Resource Include="Assets\background-dark.png" />
        <Resource Include="Assets\eye.ico" />

        <Compile Remove="ICare Tests\**" />
        <EmbeddedResource Remove="ICare Tests\**" />
        <None Remove="ICare Tests\**" />

        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Assets\eye.ico" />
    </ItemGroup>

</Project>
