<UserControl x:Class="ICare.Views.FolderContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ICare.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Background="{DynamicResource PanelSurfaceBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="FolderNameText" 
                       Text="Games"
                       FontSize="32" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="AppCountText" Text="0 apps"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
        <Border Grid.Row="0" Height="1" Background="{DynamicResource ToggleTrackBrush}"
                VerticalAlignment="Bottom" Margin="0,0,0,-8"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <CheckBox x:Name="TrackTimeCheckbox"
                            FontSize="16"
                            Content="Track time"
                            Checked="TrackTimeCheckbox_Pressed"
                            Unchecked="TrackTimeCheckbox_Pressed"
                            Margin="0,0,0,12"/>
                
                <Border Grid.Row="0" Height="1" Background="{DynamicResource ToggleTrackBrush}"
                        VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                
                <CheckBox x:Name="RuleSendNotificationCheckbox"
                             Content="Send notification"
                             Checked="RuleSendNotificationCheckbox_OnCheckedChecked" 
                             Unchecked="RuleSendNotificationCheckbox_OnCheckedChecked"
                             Margin="0,0,0,3"/>
                
                <Border Grid.Row="0" Height="1" Background="{DynamicResource ToggleTrackBrush}"
                        VerticalAlignment="Bottom" Margin="20,0,20,3"/>
                <CheckBox x:Name="RuleShowOverlayWarningCheckbox"
                             Content="Overlay warning"
                             Checked="RuleShowOverlayWarning_Checkbox_OnChecked"
                             Unchecked="RuleShowOverlayWarning_Checkbox_OnChecked"/>
            </StackPanel>

            <Border Grid.Column="1" Width="1"
                    Background="{DynamicResource ToggleTrackBrush}"
                    Margin="20,0" HorizontalAlignment="Center"/>

            

            <ItemsControl Grid.Column="2" x:Name="AppsListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"/>
                            
                            
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="5,0,0,0"/>
                            
                            <Button Grid.Column="2" 
                                    Click="RemoveApp_Click"
                                    Tag="{Binding}"
                                    Width="28" Height="28"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Resources>
                                    <Style TargetType="Border" x:Key="HoverBorder">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FFEBEE" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FFCDD2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <Path
                                    Data="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"
                                    Fill="#D32F2F"
                                    Width="16" Height="16"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Border Grid.Column="3" Width="1"
                    Background="{DynamicResource ToggleTrackBrush}"
                    Margin="20,0" HorizontalAlignment="Center"/>
            
            <ContentControl Grid.Column="4" x:Name="AddAppsSlot"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
            
            <Button Grid.Column="4" x:Name="AddAppsButton"
                    Content="+ Add apps" Click="AddAppsButton_Click"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <Button Grid.Column="4" x:Name="CloseAddAppsButton" Content="Done"
                    Click="CloseAddApps_Click"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"/>
        </Grid>
    </Grid>

</UserControl>
