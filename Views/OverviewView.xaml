<UserControl x:Class="ICare.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelSurfaceBrush}">
    <Border>
        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="180" Height="180">
                    <Canvas Width="180" Height="180">
                        <Ellipse Canvas.Left="4" Canvas.Top="4"
                                 Width="172" Height="172"
                                 Stroke="{DynamicResource OverviewEllipseBrush}" StrokeThickness="8"
                                 Fill="Transparent" />
                        <Path x:Name="TimerArc"
                              Stroke="#9E23DB" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" />
                    </Canvas>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CountdownLabel" Text="20:00"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="until break" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="SkipStatusLabel" Text="Break scheduled"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="WORK" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WorkLabel" Text="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="min" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>

                        <Border Background="#2747D6" Height="4" VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch" CornerRadius="0,0,12,12"
                                Margin="-16,-4,-16,-16" />

                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BREAK" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BreakLabel" Text="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="sec" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>

                        <Border Background="#006400" Height="4" VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch" CornerRadius="0,0,12,12"
                                Margin="-16,-4,-16,-16" />

                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TIMES SKIPPED BREAK" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TimesSkipped" Text="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="times" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ALL TIME BREAK" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BreakStatMin" Text="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="min" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid></Border>
</UserControl>