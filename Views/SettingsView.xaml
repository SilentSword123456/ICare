<UserControl x:Class="ICare.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F0E8">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40">
            <TextBlock Text="Settings" Foreground="#2D2D2D"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,32" />

            <TextBlock Text="Work duration" Foreground="#8B8B8B" FontSize="12" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="WorkBox" Style="{StaticResource StyledNumberBox}"
                         Width="50"
                         TextChanged="WorkBox_TextChanged" />
                <TextBlock Text="minutes" Foreground="#8B8B8B" FontSize="13"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="Break duration" Foreground="#8B8B8B" FontSize="12" Margin="0,24,0,6" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="BreakBox" Style="{StaticResource StyledNumberBox}"
                         Width="50"
                         TextChanged="BreakBox_TextChanged" />
                <TextBlock Text="seconds" Foreground="#8B8B8B" FontSize="13"
                           VerticalAlignment="Center" Margin="10,0,0,0" />

                <Grid x:Name="BreakWarningIcon"
                      Width="16" Height="16"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Cursor="Arrow">
                    <Grid.ToolTip>
                        <ToolTip
                            Content="It is recommended that for every X minutes of screentime to have at least X seconds of break time"
                            Placement="Top" />
                    </Grid.ToolTip>

                    <Path
                        Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"
                        Fill="#F0A500"
                        Stretch="Uniform" />

                    <Rectangle Fill="Transparent" />
                </Grid>

            </StackPanel>

            <TextBlock Text="Skip hotkey" Foreground="#8B8B8B" FontSize="12" Margin="0,24,0,6" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8E3DB" BorderBrush="#C0BAB0" BorderThickness="1"
                        CornerRadius="10" Padding="6,10">
                    <TextBlock Text="Ctrl" Foreground="#2D2D2D" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="+" Foreground="#8B8B8B" FontSize="13" VerticalAlignment="Center" Margin="4,0" />
                <Border Background="#E8E3DB" BorderBrush="#C0BAB0" BorderThickness="1"
                        CornerRadius="10" Padding="6,10">
                    <TextBlock Text="Shift" Foreground="#2D2D2D" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="+" Foreground="#8B8B8B" FontSize="13" VerticalAlignment="Center" Margin="4,0" />
                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource StyledNumberBox}"
                             Width="50" HorizontalContentAlignment="Center"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                </Border>
            </StackPanel>

            <TextBlock Text="Start automatically" Foreground="#8B8B8B" FontSize="12" Margin="0,24,0,6" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="AutoStartToggle"
                              Style="{StaticResource PillToggleButton}"
                              Checked="AutoStartToggle_Checked"
                              Unchecked="AutoStartToggle_Unchecked" />
                <!-- TODO: make it be a closed/opened eye instead of a simple toggle -->
            </StackPanel>


            <TextBlock Text="Break Message" Foreground="#8B8B8B" FontSize="12" Margin="0,24,0,6" />
            <TextBox x:Name="BreakMessage" Style="{StaticResource StyledNumberBox}"
                     TextChanged="BreakMessage_TextChanged"
                     Width="160"
                     MinHeight="40" MaxHeight="300"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>