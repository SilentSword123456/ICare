<Window x:Class="ICare.BlackoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Background>
        <ImageBrush ImageSource="/ICare;component/background.png" Stretch="UniformToFill"/>
    </Window.Background>
    
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="MessageText"
                       Text="Time to rest your eyes"
                       Foreground="White"
                       FontSize="36"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CountdownText"
                       Text="20"
                       Foreground="White"
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>